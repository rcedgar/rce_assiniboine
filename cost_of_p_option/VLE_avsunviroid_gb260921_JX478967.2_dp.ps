} def

/sequence { (\
CCCAUAAGUUUCGUCGCAUCCCAGCGACUCAUCAGUGGGCUAAGCCCAGACUUAUGAGAGAGUGGUUACCUCUCAGCCCCUCCACCUUGGGGUGCCCUAUUCGGAGCACUGCAGUUCCGAUAGAAAGGCUAAGCACUUCGCAUUGAAGUAAGGUGGGACUUUUCCCUAGGGUUUGAGCGGUCGAACCCAGGGGGAGUGUGAUCCAGGUACCGCCGUAGAAACUGGAUUACGACGCCUACCCGGGAUUCAAACCCG\
GUCCCCCUCAGAGGUGACUCUGAGUGAAAGGUCGUGCUUAGCACACUGAUGAGUUCCUGAAAUGGAACGAAACCUUUCUAA\
) } def

/len { sequence length } bind def

% BEGIN linear data array

/topData [
] def

/leftData [
] def

/bottomData [
] def

/rightData [
] def

% END linear data arrays

%Finally, prepare canvas

%draw title
drawTitle

%prepare coordinate system, draw grid and sequence
/Helvetica findfont 0.95 scalefont setfont

%prepare coordinate system
prepareCoords

%draw sequence arround grid
drawseq

%draw grid
drawgrid

%draw auxiliary linear data (if available)
drawData

